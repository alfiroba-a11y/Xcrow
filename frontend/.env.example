VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com

# Safe to expose in the browser — this is Paystack's *public* key only.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx

# Must match ADMIN_PANEL_SECRET on the backend. This only obscures the
# portal from casual discovery — real protection is the admin login + role
# check on every request, not this path.
VITE_ADMIN_PATH=x9v-control
