# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.onrender.com

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xcrow?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Paystack (get from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx

# One-time admin bootstrap (used only by `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately
ADMIN_NAME=Xcrow Admin

# USDT deposits (manual — an admin confirms these by hand, no auto-verification)
USDT_DEPOSIT_ADDRESS=0xcf8d2ad2f246055ac262a87b625418b12bf4b9f7
USDT_NETWORK=ERC20

# The obscure admin path — must match VITE_ADMIN_PATH on the frontend
ADMIN_PANEL_SECRET=x9v-control
